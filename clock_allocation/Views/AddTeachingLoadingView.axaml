<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="clock_allocation.Views.AddTeachingLoadingView"
             xmlns:vm="using:clock_allocation.ViewModels"
             xmlns:local="clr-namespace:System.Text.RegularExpressions;assembly=System.Text.RegularExpressions"
             xmlns:models="clr-namespace:clock_allocation.Models"
             xmlns:subjects="clr-namespace:System.Reactive.Subjects;assembly=System.Reactive"
             x:DataType="vm:AddTeachingLoadingViewModel">
    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#B44A45" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Padding" Value="10 5" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#9C3A3A" />
        </Style>

        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#F8E1DF" />
        </Style>

        <Style Selector="TreeView">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="CornerRadius" Value="10"></Setter>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
        </Style>

        <Style Selector="TreeViewItem">
            <Setter Property="Margin" Value="0 2" />
            <Setter Property="Padding" Value="5" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#B44A45" CornerRadius="4" Padding="10" Margin="0 0 0 10">
            <TextBlock Text="Преподавательская загрузка"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </Border>

        <!-- Поле года -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0 0 0 15">
            <TextBlock Text="Учебный год:" VerticalAlignment="Center" />
            <TextBox Text="{Binding Year}" Watermark="Введите год" Width="130" />
        </StackPanel>
        <Popup Grid.Row="2" IsOpen="{Binding IsLoading}" PlacementMode="Center">
            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Width="300"
                    Height="150">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">

                    <TextBlock Text="{Binding Message}"
                               FontSize="16"
                               Width="280"
                               TextWrapping="Wrap"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Foreground="Black" />
                </StackPanel>

            </Border>
        </Popup>
        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                      IsVisible="{Binding TeachingLoads.Count}">
            <StackPanel Spacing="10">
                <TreeView ItemsSource="{Binding TeachingLoads}">
                    <TreeView.DataTemplates>
                        <!-- Шаблон для предмета (NewTeachingLoad) -->
                        <TreeDataTemplate DataType="{x:Type models:NewTeachingLoad}"
                                          ItemsSource="{Binding Groups}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- Кнопка удаления предмета -->
                                <Button Content="-"
                                        Command="{Binding $parent[UserControl].((vm:AddTeachingLoadingViewModel)DataContext).DeleteSubject}"
                                        CommandParameter="{Binding}"
                                        Background="#da7772"
                                        Width="30" />

                                <!-- AutoCompleteBox для поиска предмета -->
                                <AutoCompleteBox Width="200"
                                                 ItemsSource="{Binding $parent[UserControl].((vm:AddTeachingLoadingViewModel)DataContext).Subjects}"
                                                 SelectedItem="{Binding Subject }"
                                                 Watermark="Выберите предмет"
                                                 MinimumPrefixLength="0"
                                                 FilterMode="Contains"
                                                 IsTextCompletionEnabled="True">
                                </AutoCompleteBox>
                                

                                <!-- Кнопка добавления группы к предмету -->
                                <Button Content="Добавить группу"
                                        Command="{Binding $parent[UserControl].((vm:AddTeachingLoadingViewModel)DataContext).AddGroup}"
                                        CommandParameter="{Binding}"
                                        Classes="primary"
                                        MinWidth="120" />
                            </StackPanel>
                        </TreeDataTemplate>

                        <!-- Шаблон для группы (Group) -->
                        <TreeDataTemplate DataType="{x:Type models:Group}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- Кнопка удаления группы -->
                                <Button Content="-"
                                        Command="{Binding $parent[UserControl].((vm:AddTeachingLoadingViewModel)DataContext).DeleteGroup}"
                                        CommandParameter="{Binding}"
                                        Background="#da7772"
                                        Width="30" />

                                <!-- AutoCompleteBox для поиска группы -->
                                <AutoCompleteBox Width="200"
                                                 ItemsSource="{Binding $parent[UserControl].((vm:AddTeachingLoadingViewModel)DataContext).Groups}"
                                                 SelectedItem="{Binding ., Mode=TwoWay}"
                                                 Watermark="Выберите группу"
                                                 MinimumPrefixLength="1"
                                                 SelectionChanged="OnGroupSelected"
                                                 FilterMode="Contains"
                                                 IsTextCompletionEnabled="True">
                                    <AutoCompleteBox.ItemTemplate>
                                        <DataTemplate DataType="models:Group">
                                            <TextBlock Text="{Binding }"/>
                                        </DataTemplate>
                                    </AutoCompleteBox.ItemTemplate>
                                </AutoCompleteBox>
                               <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                   <CheckBox IsChecked="{Binding Splitting}"></CheckBox>
                                   <TextBlock Text="Делится на подгруппы"></TextBlock>
                               </StackPanel>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </StackPanel>
        </ScrollViewer>

        <!-- Панель кнопок -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0 15 0 0">
            <Button Content="Добавить предмет" Command="{Binding AddSubject}" Classes="secondary" />
            <Button Content="Сохранить" Command="{Binding SaveChanges}" Classes="primary" />
        </StackPanel>
    </Grid>
</UserControl>