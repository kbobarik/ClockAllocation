<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:clock_allocation.ViewModels"
             mc:Ignorable="d"
             x:Class="clock_allocation.Views.AuthorizationView"
             x:DataType="vm:AuthorizationViewModel"
             Background="#f5f5f5">

    <Grid>
        <Border Background="White"
                CornerRadius="16"
                Width="400"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 0 20 0 #30000000">
            <StackPanel Spacing="15">

                <TextBlock Text="Вход в систему"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />

                <StackPanel>
                    <TextBlock Text="Логин"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#666" />
                    <TextBox Text="{Binding Login}"
                             Width="340"
                             Height="35"
                             CornerRadius="8"
                             Background="#fafafa"
                             BorderBrush="#ccc"
                             BorderThickness="1"
                             Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Пароль"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#666" />
                    <TextBox Text="{Binding Password}"
                             Width="340"
                             Height="35"
                             CornerRadius="8"
                             Background="#fafafa"
                             BorderBrush="#ccc"
                             BorderThickness="1"
                             Margin="0,5,0,0"
                             PasswordChar="*" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#D32F2F"
                           FontSize="12"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />

                <Button Content="Войти"
                        Command="{Binding Entrance}"
                        Width="340"
                        Height="40"
                        VerticalContentAlignment="Center"
                        Background="#B44A45"
                        Foreground="White"
                        FontWeight="SemiBold"
                        CornerRadius="8"
                        HorizontalContentAlignment="Center"
                        Margin="0,20,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>