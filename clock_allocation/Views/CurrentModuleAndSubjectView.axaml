<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:clock_allocation.ViewModels"
             xmlns:local="clr-namespace:clock_allocation.Models"
             xmlns:global="clr-namespace:"
             mc:Ignorable="d" 
             d:DesignWidth="800" d:DesignHeight="450"
             x:Class="clock_allocation.Views.CurrentModuleAndSubjectView"
             x:DataType="vm:CurrentModuleAndSubjectViewModel">

    <Grid RowDefinitions="Auto,*" Margin="10">
        <!-- Header with Copy Button -->
           <StackPanel Orientation="Horizontal">
               <Button x:Name="CopyButton" 
                       Background="#B44A45"
                       Foreground="White"
                       Content="Скопировать модули" 
                       Command="{Binding CopyModules}"
                       HorizontalAlignment="Left"/>
               <Button 
                       Background="White"
                       Foreground="#B44A45"
                       Content="Редактировать модули" 
                       Command="{Binding UpdateNodules}"
                       HorizontalAlignment="Left"/>
           </StackPanel>
        
        <!-- Modules TreeView -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" >
            <StackPanel Spacing="10">
                <TreeView ItemsSource="{Binding RootModules}">
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="{x:Type local:ModuleCurriculum}" 
                                          ItemsSource="{Binding Items}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Code}"  Width="120"/>
                                <TextBlock Text="{Binding Title}" Width="250"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>