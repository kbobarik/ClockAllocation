<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:clock_allocation.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="clock_allocation.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Border Background="#f8f9fa">
        <SplitView IsPaneOpen="True"
                   DisplayMode="Inline"
                   OpenPaneLength="220"
                   PaneBackground="#B44A45">

            <SplitView.Pane>
                <Border Background="#B44A45"
                        BoxShadow="0 0 10 0 #4D000000">
                    <StackPanel Margin="10" Spacing="20">
                        <Button 
                            Command="{Binding toCurriculumView}"
                            Background="White"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Foreground="#B44A45"
                            BorderThickness="0"
                            CornerRadius="8"
                            Height="60"
                            FontSize="14"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch">
                            <TextBlock Text="Учебные планы" TextWrapping="Wrap" Foreground="#B44A45" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                        </Button>

                        <Button 
                            Command="{Binding toSpecializationView}"
                            Background="White"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Foreground="#B44A45"
                            BorderThickness="0"
                            CornerRadius="8"
                            Height="60"
                            FontSize="14"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch">
                            <TextBlock Text="Специальности" TextWrapping="Wrap" Foreground="#B44A45" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                        </Button>
                        <Button 
                                Command="{Binding toAddModulesSubjectView}"
                                Background="White"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Foreground="#B44A45"
                                BorderThickness="0"
                                CornerRadius="8"
                                Height="60"
                                FontSize="14"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Модули/предметы" TextWrapping="Wrap" Foreground="#B44A45" FontSize="12" FontWeight="Bold"/>
                        </Button>
                        <Button
                                Command="{Binding toGroupView}"
                                Background="White"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Foreground="#B44A45"
                                BorderThickness="0"
                                CornerRadius="8"
                                Height="60"
                                FontSize="14"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Группы" TextWrapping="Wrap" Foreground="#B44A45" FontSize="12" FontWeight="Bold"/>
                        </Button>
                        <Button
                                Command="{Binding toTeacherView}"
                                Background="White"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Foreground="#B44A45"
                                BorderThickness="0"
                                CornerRadius="8"
                                Height="60"
                                FontSize="14"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Преподаватели" TextWrapping="Wrap" Foreground="#B44A45" FontSize="12" FontWeight="Bold"/>
                        </Button>
                        <Button 
                                Command="{Binding toTeachingLoadingView}"
                                Background="White"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Foreground="#B44A45"
                                BorderThickness="0"
                                CornerRadius="8"
                                Height="60"
                                FontSize="14"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Преподавательская нагрузка" TextWrapping="Wrap" Foreground="#B44A45" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                        </Button>

                    </StackPanel>
                </Border>

            </SplitView.Pane>

            <Border Margin="20" Background="White" CornerRadius="12" Padding="20">
                <UserControl Content="{Binding UserControl}" />
            </Border>

        </SplitView>
    </Border>
</UserControl>