<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="clock_allocation.Views.SpecializationView"
             xmlns:vm="using:clock_allocation.ViewModels"
             x:DataType="vm:SpecializationViewModel"
             xmlns:conv="clr-namespace:clock_allocation.Resources"
             Background="#f5f5f5">

    <UserControl.Resources>
        <conv:SpecializationToString x:Key="Converter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *" Margin="20">
        <Popup IsOpen="{Binding IsDelete}" PlacementMode="Center">
            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Width="300"
                    Height="150">

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">

                    <TextBlock Text="Вы уверены, что хотите удалить?"
                               FontSize="16"
                               Width="400"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               Foreground="Black" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,0">

                        <!-- Кнопка "Да" -->
                        <Button Content="Да"
                                Command="{Binding DeleteSpecialization}"
                                Background="#D32F2F"
                                Foreground="White"
                                Width="100"
                                Height="35"
                                CornerRadius="6" />

                        <!-- Кнопка "Нет" -->
                        <Button Content="Нет"
                                Command="{Binding CancelDeleteCommand}"
                                Background="#757575"
                                Foreground="White"
                                Width="100"
                                Height="35"
                                CornerRadius="6" />
                    </StackPanel>
                </StackPanel>

            </Border>
        </Popup>
        <DockPanel LastChildFill="False" Margin="0,0,0,10" VerticalAlignment="Center" Height="50">
            <Border Background="#EFEFEF" CornerRadius="8" Margin="0,0,10,0" Height="40" VerticalAlignment="Center">
                <TextBox Text="{Binding Query}"
                         Watermark="Поиск..."
                         Width="300"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="10,0"
                         FontSize="14"
                         VerticalContentAlignment="Center" />
            </Border>
            <Button Content="Добавить специальность"
                    Command="{Binding AddSpecialization}"
                    Background="#B44A45"
                    Foreground="White"
                    Height="40"
                    Width="220"
                    CornerRadius="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    Padding="10,0"
                    DockPanel.Dock="Right"
                    Margin="0,0,0,0" />
        </DockPanel>

        <Border Background="White" CornerRadius="12" Padding="20" BoxShadow="0 0 15 0 #20000000" Grid.Row="1">
            <ScrollViewer>
                <StackPanel Spacing="10">
                    <Border Background="#B44A45" CornerRadius="8" Padding="10">
                        <Grid ColumnDefinitions="*,2*,*,*,*,*,*,*">
                            <TextBlock Grid.Column="0" Text="Специальность" Foreground="White" FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1"
                                       Text="Образовательная программа, направленность, профиль, шифр и наименование научной специальности"
                                       Foreground="White" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="Квалификация" Foreground="White" FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="3" Text="Уровень образования" Foreground="White" FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="4" Text="Форма обучения" Foreground="White" FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="5" Text="Нормативный срок обучения" Foreground="White"
                                       FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="6" Text="Язык обучения" Foreground="White" FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="7" Text="Действия" Foreground="White" FontWeight="Bold"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Specializations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#fafafa" CornerRadius="6" Padding="10" Margin="0,5,0,0">
                                    <Grid ColumnDefinitions="*,2*,*,*,*,*,*,*">
                                        <TextBlock Grid.Column="0" Margin="2"
                                                   Text="{Binding Converter={StaticResource Converter}}"
                                                   TextWrapping="Wrap" Foreground="#333" />
                                        <TextBlock Grid.Column="1" Margin="2" Text="{Binding Direction}"
                                                   TextWrapping="Wrap" Foreground="#333" />
                                        <TextBlock Grid.Column="2" Margin="2" Text="{Binding Qualification}"
                                                   TextWrapping="Wrap" Foreground="#333" />
                                        <TextBlock Grid.Column="3" Margin="2" Text="{Binding EducationLevel}"
                                                   TextWrapping="Wrap" Foreground="#333" />
                                        <TextBlock Grid.Column="4" Margin="2" Text="{Binding FormOfEducation}"
                                                   TextWrapping="Wrap" Foreground="#333" />
                                        <TextBlock Grid.Column="5" Margin="2" Text="{Binding DurationOfTraining}"
                                                   TextWrapping="Wrap" Foreground="#333" />
                                        <TextBlock Grid.Column="6" Margin="2"
                                                   Text="{Binding IdLanguageNavigation.Title}" TextWrapping="Wrap"
                                                   Foreground="#333" />
                                        <StackPanel Grid.Column="7" Orientation="Vertical">
                                            <Button Content="Редактировать"
                                                    Command="{Binding $parent[UserControl].((vm:SpecializationViewModel)DataContext).UpdateSpecialization}"
                                                    CommandParameter="{Binding}"
                                                    Background="#B44A45"
                                                    Foreground="White"
                                                    CornerRadius="3"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Padding="10,0"
                                                    Margin="0,0,0,0" />
                                            <Button Content="Удалить"
                                                    Command="{Binding $parent[UserControl].((vm:SpecializationViewModel)DataContext).ConfirmationOfDeletion}"
                                                    CommandParameter="{Binding}"
                                                    Background="#B44A45"
                                                    Foreground="White"
                                                    CornerRadius="3"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Padding="10,0"
                                                    Margin="0,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>