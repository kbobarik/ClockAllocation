<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="clock_allocation.Views.UpdateTeacherLoadingView"
             xmlns:vm="using:clock_allocation.ViewModels"
             x:DataType="vm:UpdateTeachingLoadViewModel">
    <Grid RowDefinitions="*,Auto">
         <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
             <ContentControl Content="{Binding TeachingLoad}"></ContentControl>
            </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" >
            <Border Width="130" Height="50" Margin="2">
                <Button Background="#B44A45" Foreground="White" Command="{Binding Save}" >
                    <TextBlock Text="Сохранить" TextWrapping="Wrap" FontSize="12" HorizontalAlignment="Center" />
                </Button>
            </Border>
            <Border Width="130" Height="50" Margin="2">
                <Button Background="White" Foreground="#B44A45" Command="{Binding Cancel}">
                    <TextBlock Text="Отмена" TextWrapping="Wrap" FontSize="12" HorizontalAlignment="Center" />
                </Button>
            </Border>
        </StackPanel>
    </Grid>
   
</UserControl>
